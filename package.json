{
  "name": "cpp-headdoc",
  "displayName": "C++ HeadDoc",
  "description": "%extension.description%",
  "version": "0.2.2",
  "publisher": "TimZou",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/timzou/cpp-headdoc.git"
  },
  "bugs": {
    "url": "https://github.com/timzou/cpp-headdoc/issues"
  },
  "homepage": "https://github.com/timzou/cpp-headdoc#readme",
  "engines": {
    "vscode": "^1.134.0",
    "node": ">=24"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "cpp",
    "c++",
    "doxygen",
    "documentation",
    "codelens",
    "clangd",
    "header",
    "hpp"
  ],
  "main": "./dist/extension.js",
  "icon": "images/icon.png",
  "l10n": "./l10n",
  "activationEvents": [
    "onLanguage:cpp",
    "onLanguage:c",
    "onCommand:cppHeadDoc.refresh",
    "onCommand:cppHeadDoc.toggle",
    "onCommand:cppHeadDoc.showDocumentation",
    "onCommand:cppHeadDoc.toggleInlineDocumentation",
    "onCommand:cppHeadDoc.openMarkdownPreview",
    "onCommand:cppHeadDoc.goToDeclaration",
    "onCommand:cppHeadDoc.checkSetup"
  ],
  "contributes": {
    "commands": [
      {
        "command": "cppHeadDoc.refresh",
        "title": "%command.refresh%"
      },
      {
        "command": "cppHeadDoc.toggle",
        "title": "%command.toggle%"
      },
      {
        "command": "cppHeadDoc.showDocumentation",
        "title": "%command.showDocumentation%"
      },
      {
        "command": "cppHeadDoc.toggleInlineDocumentation",
        "title": "%command.toggleInlineDocumentation%"
      },
      {
        "command": "cppHeadDoc.openMarkdownPreview",
        "title": "%command.openMarkdownPreview%"
      },
      {
        "command": "cppHeadDoc.goToDeclaration",
        "title": "%command.goToDeclaration%"
      },
      {
        "command": "cppHeadDoc.checkSetup",
        "title": "%command.checkSetup%"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "cppHeadDoc.goToDeclaration",
          "when": "resourceScheme == cpp-head-doc",
          "group": "navigation@1"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "cppHeadDoc.goToDeclaration",
          "when": "commentThread == cppHeadDoc.readonlyDocumentation",
          "group": "inline@1"
        },
        {
          "command": "cppHeadDoc.openMarkdownPreview",
          "when": "commentThread == cppHeadDoc.readonlyDocumentation",
          "group": "inline@2"
        }
      ]
    },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "cppHeadDoc.enabled": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.enabled%"
        },
        "cppHeadDoc.showCodeLens": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.showCodeLens%"
        },
        "cppHeadDoc.showHover": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.showHover%"
        },
        "cppHeadDoc.showInlineComments": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.showInlineComments%"
        },
        "cppHeadDoc.inlineCommentsExpanded": {
          "type": "boolean",
          "scope": "resource",
          "default": false,
          "description": "%configuration.inlineCommentsExpanded%"
        },
        "cppHeadDoc.inlineCommentTextSize": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "small",
            "medium",
            "large"
          ],
          "default": "medium",
          "description": "%configuration.inlineCommentTextSize%"
        },
        "cppHeadDoc.summaryStyle": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "brief",
            "briefAndParams",
            "briefAndTags"
          ],
          "default": "briefAndTags",
          "description": "%configuration.summaryStyle%"
        },
        "cppHeadDoc.maxSummaryLength": {
          "type": "number",
          "scope": "resource",
          "minimum": 40,
          "maximum": 500,
          "default": 180,
          "description": "%configuration.maxSummaryLength%"
        },
        "cppHeadDoc.showParametersInCodeLens": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.showParametersInCodeLens%"
        },
        "cppHeadDoc.showReturnValueInCodeLens": {
          "type": "boolean",
          "scope": "resource",
          "default": true,
          "description": "%configuration.showReturnValueInCodeLens%"
        },
        "cppHeadDoc.headerExtensions": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [
            ".h",
            ".hpp",
            ".hh",
            ".hxx"
          ],
          "description": "%configuration.headerExtensions%"
        },
        "cppHeadDoc.sourceExtensions": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [
            ".c",
            ".cc",
            ".cpp",
            ".cxx"
          ],
          "description": "%configuration.sourceExtensions%"
        },
        "cppHeadDoc.maxCommentSearchLines": {
          "type": "number",
          "scope": "resource",
          "minimum": 5,
          "maximum": 500,
          "default": 40,
          "description": "%configuration.maxCommentSearchLines%"
        },
        "cppHeadDoc.debounceMs": {
          "type": "number",
          "scope": "resource",
          "minimum": 50,
          "maximum": 5000,
          "default": 300,
          "description": "%configuration.debounceMs%"
        },
        "cppHeadDoc.maxCacheEntries": {
          "type": "number",
          "scope": "resource",
          "minimum": 20,
          "maximum": 5000,
          "default": 500,
          "description": "%configuration.maxCacheEntries%"
        },
        "cppHeadDoc.logLevel": {
          "type": "string",
          "scope": "resource",
          "enum": [
            "off",
            "error",
            "info",
            "debug"
          ],
          "default": "error",
          "description": "%configuration.logLevel%"
        }
      }
    }
  },
  "scripts": {
    "clean": "node -e \"for(const p of ['dist','dist-test','coverage','release'])require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "compile": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --sourcemap --outfile=dist/extension.js --watch",
    "compile:test": "esbuild test/integration/index.ts --bundle --platform=node --format=cjs --external:vscode --external:mocha --outfile=dist-test/integration.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "mocha --import=tsx \"test/unit/**/*.test.ts\"",
    "test:integration": "npm run compile && npm run compile:test && node test/runIntegration.mjs",
    "verify": "npm run check && npm run lint && npm run compile && npm run test:unit && npm run test:integration",
    "package": "npm run compile && node -e \"require('node:fs').mkdirSync('release',{recursive:true})\" && vsce package --out release/cpp-headdoc-0.2.2.vsix"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.10.0",
    "@types/vscode": "1.134.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "mocha": "11.8.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  },
  "overrides": {
    "diff": "8.0.3",
    "serialize-javascript": "7.0.5"
  }
}
